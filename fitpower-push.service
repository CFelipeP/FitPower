[Unit]
Description=FitPower Push Notification Server
After=network.target

[Service]
Type=simple
User=fitpower
WorkingDirectory=/home/fitpower/FitPower
ExecStart=/usr/bin/node push-server.cjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# INTERNAL_API_SECRET must match api/.env on the target host.
EnvironmentFile=-/home/fitpower/FitPower/api/.env

[Install]
WantedBy=multi-user.target
